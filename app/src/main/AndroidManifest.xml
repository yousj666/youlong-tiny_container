<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".Tc4Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/tc4_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TinyContainer"
        >
        <!--
            MainActivity 本身不再是启动器入口：
            MAIN/LAUNCHER 移到了下面 enabled=false 的 LauncherAlias 别名上，
            因此安装后桌面与应用列表都不会出现图标。
            可用入口：
              1) 任意文件管理器 -> 分享/打开方式 -> 游龙容器插件（SEND，*/*）
              2) 已固定的桌面快捷方式（com.youlong.computer.action.SHORTCUT）
              3) 应用内「设置 -> 桌面图标」把 LauncherAlias 打开即可恢复图标
        -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <!-- Import files to public folder (any format) -->
            <intent-filter android:label="@string/tc4_import_file_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- ShortcutManager 快捷方式启动 -->
            <intent-filter>
                <action android:name="com.youlong.computer.action.SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            桌面图标开关（默认关闭 = 安装后不显示图标）。
            通过 PackageManager.setComponentEnabledSetting 运行时开启/关闭，
            重新安装或升级 APK 后会恢复成清单里的默认值（隐藏）。
        -->
        <activity-alias
            android:name=".ui.main.LauncherAlias"
            android:targetActivity=".ui.main.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tc4_app_name"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.page.WebViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.page.Signal9Activity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.page.OpenSourceLibsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.page.LicenseActivity"
            android:exported="false" />

        <!-- 图形界面显示活动（Termux:X11 / Termux Desktop）：负责屏幕方向的首次询问与方向接管 -->
        <activity
            android:name=".ui.page.X11DisplayActivity"
            android:exported="false"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="stateHidden" />

        <provider
            android:name=".ui.misc.TinyDocumentsProvider"
            android:authorities="${applicationId}.docs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>